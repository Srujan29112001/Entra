# ============================================================================
# Entra - AI-Powered Entrepreneur Support Platform
# Complete Environment Configuration
#
# IMPORTANT: Replace ALL placeholder values before deploying to production!
# Run validation: python apps/agents/app/config_validator.py production
# ============================================================================

# ============================================================================
# ENVIRONMENT
# ============================================================================
NODE_ENV=development
ENVIRONMENT=development  # development, staging, production
DEBUG=true

# ============================================================================
# DATABASE & AUTH (Supabase)
# ============================================================================
# Get credentials from: https://app.supabase.com/project/_/settings/api

# Frontend (Next.js)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Backend (Python)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ============================================================================
# LLM APIs (REQUIRED)
# ============================================================================

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview

# Anthropic Claude (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ============================================================================
# REAL-TIME ECONOMIC & MARKET DATA APIs
# ============================================================================

# FRED API (REQUIRED for real economic data)
# Get key at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your-fred-api-key-32-chars-long

# Alpha Vantage (for stock market data)
# Get key at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key-here

# NewsAPI (for market & business news)
# Get key at: https://newsapi.org/register
NEWS_API_KEY=your-news-api-key-32-chars-long

# World Bank API - no key required (public API)
# Documentation: https://datahelpdesk.worldbank.org/knowledgebase/articles/889392

# ============================================================================
# BACKEND API
# ============================================================================
BACKEND_API_URL=http://localhost:8000
API_V1_PREFIX=/api/v1
APP_NAME=Entra
APP_VERSION=2.0.0

# ============================================================================
# MONITORING & OBSERVABILITY
# ============================================================================

# Helicone (LLM observability - RECOMMENDED for production)
# Get key at: https://www.helicone.ai/
HELICONE_API_KEY=sk-helicone-your-key-here

# Sentry (Error tracking - RECOMMENDED for production)
# Get DSN at: https://sentry.io/
SENTRY_DSN=https://your-key@your-org.ingest.sentry.io/your-project-id

# ============================================================================
# SECURITY & CORS
# ============================================================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,https://your-domain.com

# ============================================================================
# PROTOCOLS & FEATURES
# ============================================================================

# Model Context Protocol (MCP)
MCP_ENABLED=true

# Agent-to-Agent (A2A) Protocol
A2A_ENABLED=true

# RAG Knowledge Base
ENABLE_RAG=true
ENABLE_KNOWLEDGE_BASE_AUTO_POPULATE=false  # Auto-ingest documents on startup

# Vision/Multimodal AI
ENABLE_VISION=true

# Real-time data
ENABLE_REAL_TIME_DATA=true

# ============================================================================
# OPTIONAL: CACHING & PERFORMANCE
# ============================================================================
REDIS_URL=redis://localhost:6379  # Optional: for caching frequently accessed data

# ============================================================================
# DEVELOPMENT ONLY - NEVER USE IN PRODUCTION!
# ============================================================================
USE_MOCK_DATA=false  # MUST be false in production
ALLOW_PLACEHOLDER_KEYS=false  # MUST be false in production
